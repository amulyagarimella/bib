# Copy to .env.local for `vercel dev`, and add these in the Vercel dashboard
# under Project → Settings → Environment Variables for production.

# Your numeric Zotero user ID (NOT your username).
# Find it at: https://www.zotero.org/settings/keys  → "Your userID for use in API calls is ..."
ZOTERO_USER_ID=

# The collection key — the part after /collections/ in the collection's URL,
# or visible in the Zotero web library URL when the collection is selected.
ZOTERO_COLLECTION_KEY=

# A READ-ONLY API key. Create one at https://www.zotero.org/settings/keys/new
# Grant only "Allow library access" (read). Keep this secret — it stays server-side.
ZOTERO_API_KEY=
