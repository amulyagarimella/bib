# Copy to .env.local for local dev, and set the same in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# --- Admin login (Basic Auth) for the home/management screen ---------------
# The username is optional (defaults to "admin"). The password is required;
# if it's unset the admin screen is locked out entirely (fails closed).
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Vercel KV / Upstash Redis (stores the registry of shared collections) --
# Added automatically when you attach a KV (Upstash Redis) store to the project
# via the Vercel dashboard → Storage. Either KV_* or UPSTASH_* names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Zotero account --------------------------------------------------------
# Every shared collection is read with these credentials.
# Find USER_ID + create a read-only API_KEY at https://www.zotero.org/settings/keys
ZOTERO_USER_ID=
ZOTERO_API_KEY=
